// Only options that differ from the oxfmt defaults.
{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": ["**/.cache/**", "**/coverage/**", "**/dist/**", "**/node_modules/**", "**/package-lock.json"],
  "printWidth": 180,
  "singleQuote": true,
  "quoteProps": "consistent",
  "sortImports": {
    "groups": [
      "side_effect",
      { "newlinesBetween": true },
      "builtin",
      { "newlinesBetween": true },
      "external",
      { "newlinesBetween": true },
      ["internal", "subpath"],
      { "newlinesBetween": true },
      ["parent", "sibling", "index"],
      { "newlinesBetween": true },
      "style",
      { "newlinesBetween": true },
      "unknown"
    ]
  },
  "sortPackageJson": false
}

{
  "name": "matterbridge-rgbww-led-controller",
  "version": "1.0.5",
  "description": "Matterbridge plugin for ESP RGBWW LED controllers",
  "author": "Roman Schlich",
  "license": "Apache-2.0",
  "homepage": "https://github.com/california444/matterbridge-rgbww-led-controller#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/california444/matterbridge-rgbww-led-controller.git"
  },
  "bugs": {
    "url": "https://github.com/california444/matterbridge-rgbww-led-controller/issues"
  },
  "keywords": [
    "matterbridge",
    "matterbridge-plugin",
    "matter",
    "rgbww",
    "led",
    "esp8266",
    "light",
    "homekit",
    "google-home",
    "alexa",
    "home-assistant"
  ],
  "type": "module",
  "main": "dist/module.js",
  "exports": {
    ".": {
      "import": "./dist/module.js"
    }
  },
  "engines": {
    "node": ">=22.13.0 <23.0.0 || >=24.0.0 <25.0.0 || >=26.0.0 <27.0.0"
  },
  "files": [
    "dist",
    "*.config.json",
    "*.schema.json"
  ],
  "scripts": {
    "start": "matterbridge",
    "build": "tsc --project tsconfig.build.json",
    "buildProduction": "tsc --project tsconfig.build.json --declaration false --declarationMap false --sourceMap false --removeComments",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "cleanBuild": "npm run clean && npm run build",
    "watch": "tsc --project tsconfig.build.json --watch",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage --coverage.thresholds.statements=90 --coverage.thresholds.branches=90 --coverage.thresholds.lines=90 --coverage.thresholds.functions=90",
    "lint": "oxlint --disable-nested-config",
    "lint:fix": "oxlint --disable-nested-config --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage",
    "prepack": "npm run clean && npm run buildProduction",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.1.1",
    "matterbridge": "3.11.3",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
